{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "installCommand": "pip install -r requirements-vercel.txt",
        "includeFiles": [
          "templates/**",
          "static/**",
          "tokenizer.pkl",
          "label_encoder.pkl"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "USE_LOCAL_MODEL": "false"
  }
}